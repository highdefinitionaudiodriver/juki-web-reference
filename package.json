{
  "name": "resident-record-web",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "node apps/api/src/server.js",
    "web:dev": "npm --workspace @resident-record/web run dev",
    "web:build": "npm --workspace @resident-record/web run build",
    "web:typecheck": "npm --workspace @resident-record/web run typecheck",
    "web:test": "npm --workspace @resident-record/web run test",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api:dev\" \"npm:web:dev\"",
    "build": "npm run generate:openapi && npm run web:build",
    "generate:openapi": "npm --workspace @resident-record/openapi run generate",
    "smoke": "node apps/api/src/server.js --smoke",
    "check": "node --check apps/api/src/server.js && node tools/check-keycloak-realm.mjs && npm run web:typecheck",
    "e2e": "playwright test",
    "e2e:api": "playwright test -c playwright.api.config.ts",
    "e2e:spring": "playwright test -c playwright.spring.config.ts",
    "e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "e2e:install": "playwright install chromium",
    "openapi:diff": "node tools/openapi-diff.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.1.0",
    "js-yaml": "^4.1.1",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}
